{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2025",
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "isolatedModules": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "eslint.config.*",
    "vite.config.*",
    "vite-html-partials.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
