# Internal backend origin used for SSR and baked into Next proxy rewrites.
# Build and runtime values must match; startup fails on a mismatch.
BACKEND_ORIGIN=http://127.0.0.1:3000

# Browser Socket.IO stays same-origin by default. Set only for a deliberate
# cross-origin development deployment; production uses the sanitized proxy.
NEXT_PUBLIC_SOCKET_IO_URL=
NEXT_PUBLIC_SOCKET_IO_PATH=/socket.io

# Direct standalone defaults. Root production supervision instead exposes its
# sanitizing proxy on FRONTEND_PORT and runs Next on a private internal port.
PORT=3001
HOSTNAME=0.0.0.0
