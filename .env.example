# 36chan example environment. Copy to `.env` and fill in real values.
# NEVER commit a real .env. The server hand-parses this file (no dotenv).

# --- Server ---
PORT=3000
NODE_ENV=development
# Directory served as static frontend (built assets) in production.
STATIC_ROOT=
# CSP response headers (recommended on in production).
CSP_ENABLED=true

# --- Admin login ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Secrets (use long random values; server refuses defaults in production) ---
JWT_SECRET=
DELETE_PASSWORD_SECRET=
MODERATION_FINGERPRINT_SECRET=
POSTER_PROOF_SECRET=
# Optional: salt for secure tripcodes (name##secret); falls back to JWT_SECRET.
TRIPCODE_SECRET=

# --- Store ---
# json (dev default) or mongo. Production REQUIRES mongo.
STORE_DRIVER=json
MONGODB_URI=

# --- HTTP rate limiter ---
# memory is per process. Use redis for multi-instance production deployments.
RATE_LIMIT_STORE=memory
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_FAILURE_MODE=closed
RATE_LIMIT_REDIS_PREFIX=36chan:rate-limit:

# --- AI provider (auto-detected from keys; google or openai-compatible) ---
AI_PROVIDER=
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.5-flash
GOOGLE_TTS_MODEL=gemini-3.1-flash-tts-preview
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_VISION_MODEL=
OPENAI_TRANSCRIBE_MODEL=
OPENAI_TTS_MODEL=
ADMIN_DIGEST_DAILY_LIMIT=
# Safe default 0 queues all Flagged moderation results; admins can override it in the UI.
# Accepts 0..1 or 0..100.
AI_MODERATION_QUEUE_CONFIDENCE_THRESHOLD=0

# --- hCaptcha ---
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# --- Image storage (local disk or s3) ---
IMAGE_STORAGE_DRIVER=local
UPLOAD_ROOT=
# Max decoded size per uploaded image/video in bytes (default 50 MiB = 52428800).
MAX_IMAGE_BYTES=
MAX_THUMBNAIL_BYTES=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=
# Public base URL for served objects. MUST include the bucket path segment,
# e.g. https://cdn.example.com/36chan-uploads
S3_PUBLIC_BASE_URL=

# --- Forum limits ---
MAX_ACTIVE_THREADS_PER_BOARD=
THREAD_BUMP_LIMIT=
THREAD_REPLY_LIMIT=
