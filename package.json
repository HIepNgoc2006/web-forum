{
  "name": "36chan-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm --prefix backend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:frontend-next": "npm --prefix frontend-next run dev",
    "start": "npm --prefix backend start",
    "test": "npm --prefix backend test",
    "test:e2e": "node scripts/browser-smoke.mts",
    "loadtest:write": "node scripts/load-test-write-path.mts",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:frontend-next": "npm --prefix frontend-next run build",
    "check": "npm run typecheck && npm --prefix backend run check && npm --prefix frontend run lint",
    "typecheck": "npm run typecheck:scripts && npm --prefix backend run typecheck && npm --prefix frontend run typecheck",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "typecheck:frontend-next": "npm --prefix frontend-next run typecheck",
    "release:verify": "npm test && npm run check && npm run build && npm run test:e2e",
    "migrate:images": "npm --prefix backend run migrate:images --",
    "cleanup:uploads": "npm --prefix backend run cleanup:uploads --",
    "backup:run": "npm --prefix backend run backup:run --",
    "backup:schedule": "npm --prefix backend run backup:schedule --",
    "seed:export": "npm --prefix backend run seed:export --",
    "seed:import": "npm --prefix backend run seed:import --",
    "seed:restore": "npm --prefix backend run seed:restore --"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
