PORT=3000

# Persistence driver: json for local/dev, mongo for production-like storage.
STORE_DRIVER=json

# Required for admin dashboard login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-long-random-secret

# Optional secret for hashed moderation cooldown/ban fingerprints. Defaults to JWT_SECRET in dev.
MODERATION_FINGERPRINT_SECRET=change-me-long-random-secret

# Optional secret for local poster-token OP proof. Defaults to JWT_SECRET in dev.
POSTER_PROOF_SECRET=change-me-long-random-secret

# Optional production captcha integration.
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# Required only when STORE_DRIVER=mongo.
MONGODB_URI=mongodb://127.0.0.1:27017/36chan

# Optional Google AI Studio integration. Moderation has local heuristic fallback; summary/suggestions require this key.
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-1.5-flash

# Optional image limit for JSON data-url uploads.
MAX_IMAGE_BYTES=1500000

# Image storage driver: local for dev, s3 for S3-compatible object storage.
IMAGE_STORAGE_DRIVER=local

# Local uploaded image storage. Public URLs are served from /uploads/* when IMAGE_STORAGE_DRIVER=local.
UPLOAD_ROOT=data/uploads

# Required only when IMAGE_STORAGE_DRIVER=s3. Works with S3-compatible services such as MinIO/R2.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_KEY_PREFIX=uploads

# Used when serving the Vite frontend separately in development.
FRONTEND_ORIGIN=http://localhost:5173

# Optional override for backend static serving.
# Defaults to ../frontend/dist when built, otherwise ../frontend.
STATIC_ROOT=
