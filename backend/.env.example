PORT=3000

# Persistence driver: mongo for production; json is only for local/dev/demo fallback.
STORE_DRIVER=json

# Required for admin dashboard login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Required in production: strong, non-default, >=32 characters. The server
# refuses to start in NODE_ENV=production with a missing/default/short value.
JWT_SECRET=change-me-long-random-secret

# Secret for hashed moderation cooldown/ban fingerprints. Falls back to JWT_SECRET
# in dev; REQUIRED in production (server refuses to start if missing).
MODERATION_FINGERPRINT_SECRET=change-me-long-random-secret

# Secret for local poster-token OP proof. Falls back to JWT_SECRET in dev;
# REQUIRED in production (server refuses to start if missing).
POSTER_PROOF_SECRET=change-me-long-random-secret

# Optional salt for secure tripcodes (name##secret). Falls back to JWT_SECRET.
# Set a dedicated value to make secure tripcodes unforgeable and site-specific.
TRIPCODE_SECRET=change-me-long-random-secret

# Production captcha integration. In NODE_ENV=production, posting and account
# registration require a valid HCAPTCHA_SECRET (server refuses to start without
# it); the dev-pass fallback only works outside production.
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# Required when STORE_DRIVER=mongo. Do not commit real production credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/36chan

# Optional Google AI Studio integration. Moderation has local heuristic fallback; summary/suggestions require this key.
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-1.5-flash

# Optional moderation queue confidence threshold. Safe default 0 queues every Flagged AI result.
# Admins can override this default from the moderation UI.
# Values can be 0..1 or 0..100; missing confidence still queues Flagged content.
AI_MODERATION_QUEUE_CONFIDENCE_THRESHOLD=0

# Optional AI provider override: 'google' or 'openai-compatible'. Leave blank to auto-detect based on env keys.
AI_PROVIDER=

# OpenAI-Compatible integration (alternative to Google).
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=gpt-4-turbo

# Optional image limit for JSON data-url uploads.
MAX_IMAGE_BYTES=1500000

# HTTP rate limiter backend. Use redis for multi-instance production deployments.
RATE_LIMIT_STORE=memory
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_FAILURE_MODE=closed
RATE_LIMIT_REDIS_PREFIX=36chan:rate-limit:

# Image storage driver: local for dev, s3 for S3-compatible object storage.
IMAGE_STORAGE_DRIVER=local

# Local uploaded image storage. Public URLs are served from /uploads/* when IMAGE_STORAGE_DRIVER=local.
UPLOAD_ROOT=data/uploads

# Required only when IMAGE_STORAGE_DRIVER=s3. Works with S3-compatible services such as MinIO/R2.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_KEY_PREFIX=uploads

# Used when serving the Vite frontend separately in development.
FRONTEND_ORIGIN=http://localhost:5173

# Optional override for backend static serving.
# Defaults to ../frontend/dist when built, otherwise ../frontend.
STATIC_ROOT=

# Realtime (SSE) production limits. Hard cap on concurrent SSE clients per
# process; over-cap connections are rejected with HTTP 503. Heartbeat keeps
# connections and proxies alive and drops dead clients. Metrics/alert thresholds
# are exposed under /api/health -> realtime.
SSE_MAX_CLIENTS=1000
SSE_HEARTBEAT_MS=25000
