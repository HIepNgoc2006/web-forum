{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2025"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "server.ts",
    "src/**/*.js",
    "src/**/*.ts",
    "test/**/*.js",
    "test/**/*.ts",
    "scripts/**/*.js",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "data",
    "uploads"
  ]
}
