{
  "name": "36chan-backend",
  "version": "0.1.0",
  "description": "Backend API for 36chan.",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "dev": "node --watch server.ts",
    "start": "node server.ts",
    "test": "node test/run-tests.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "node scripts/check-syntax.ts",
    "smoke:realtime-live": "node scripts/realtime-live-smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:images": "node scripts/migrate-inline-images.ts",
    "cleanup:uploads": "node scripts/cleanup-orphan-uploads.ts",
    "backup:run": "node scripts/backup-scheduler.ts run",
    "backup:schedule": "node scripts/backup-scheduler.ts schedule",
    "seed:export": "node scripts/seed-data.ts export",
    "seed:import": "node scripts/seed-data.ts import",
    "seed:restore": "node scripts/seed-data.ts restore"
  },
  "keywords": [
    "36chan",
    "imageboard",
    "express",
    "socket.io",
    "mongoose"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@simplewebauthn/server": "^13.3.1",
    "express": "^5.2.1",
    "mongoose": "^9.6.2",
    "qrcode": "^1.5.4",
    "redis": "^6.0.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "socket.io-client": "^4.8.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
