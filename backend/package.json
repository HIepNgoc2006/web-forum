{
  "name": "36chan-backend",
  "version": "0.1.0",
  "description": "Backend API for 36chan.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "test": "node test/run-tests.js",
    "check": "node --check server.js",
    "migrate:images": "node scripts/migrate-inline-images.js",
    "cleanup:uploads": "node scripts/cleanup-orphan-uploads.js",
    "backup:run": "node scripts/backup-scheduler.js run",
    "backup:schedule": "node scripts/backup-scheduler.js schedule",
    "seed:export": "node scripts/seed-data.js export",
    "seed:import": "node scripts/seed-data.js import",
    "seed:restore": "node scripts/seed-data.js restore"
  },
  "keywords": [
    "36chan",
    "imageboard",
    "express",
    "socket.io",
    "mongoose"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@simplewebauthn/server": "^13.3.1",
    "express": "^5.2.1",
    "mongoose": "^9.6.2",
    "qrcode": "^1.5.4",
    "redis": "^6.0.0",
    "socket.io": "^4.8.3"
  }
}
