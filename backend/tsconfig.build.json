{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "server.js",
    "src/**/*.js",
    "src/**/*.ts",
    "scripts/**/*.js",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "data",
    "uploads",
    "test"
  ]
}
