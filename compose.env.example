ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-long-password
JWT_SECRET=replace-with-long-random-secret
MODERATION_FINGERPRINT_SECRET=replace-with-long-random-secret
POSTER_PROOF_SECRET=replace-with-long-random-secret
HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET=replace-with-hcaptcha-secret
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=replace-with-long-url-safe-root-password
MONGO_APP_USERNAME=chanapp
MONGO_APP_PASSWORD=replace-with-long-url-safe-app-password
MONGO_REPLICA_SET_KEY=replace-with-long-random-base64-replica-set-key
MONGODB_URI=mongodb://chanapp:replace-with-long-url-safe-app-password@mongo:27017/36chan?replicaSet=rs0&authSource=36chan
RESEND_API_KEY=
EMAIL_FROM=
APP_BASE_URL=
EMAIL_OTP_SECRET=
AI_PROVIDER=
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-1.5-flash
GOOGLE_TTS_MODEL=gemini-3.1-flash-tts-preview
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=gpt-4-turbo
AI_MODERATION_QUEUE_CONFIDENCE_THRESHOLD=0
KLIPY_API_KEY=
MAX_IMAGE_BYTES=52428800
RATE_LIMIT_STORE=memory
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_FAILURE_MODE=closed
RATE_LIMIT_REDIS_PREFIX=36chan:rate-limit:
# Upstash TLS endpoint, for example rediss://default:token@host:6379.
# Do not use UPSTASH_REDIS_REST_URL: Socket.IO fan-out requires Pub/Sub.
REALTIME_REDIS_URL=
REALTIME_REDIS_REQUIRED=false
REALTIME_REDIS_FAILURE_MODE=closed
REALTIME_REDIS_PREFIX=36chan:realtime:
REALTIME_PRESENCE_TTL_SECONDS=45
REALTIME_UNREAD_TTL_SECONDS=60
SOCKET_IO_MAX_BUFFER_BYTES=1000000
DM_SEND_RATE_LIMIT=30
DM_READ_RATE_LIMIT=120
DM_TYPING_RATE_LIMIT=30
# The supervised backend is loopback-only and trusts only the public proxy,
# which overwrites forwarding headers from the incoming socket.
TRUST_PROXY=1
# Prometheus scrape secret for /metrics and /api/metrics (Bearer or X-Metrics-Token header).
# Required in production, including scrapes forwarded over loopback.
METRICS_TOKEN=replace-with-long-random-metrics-token
# Optional comma-separated browser origins allowed for SSE/Socket.IO CORS.
# CORS_ORIGINS=https://36chan.example
# Short in-process cache for /api/config, /api/boards, /api/stats (ms). 0 disables.
PUBLIC_READ_CACHE_MS=2000
# JWT lifetime overrides (seconds): privileged roles default 8h, accounts default 7d.
# PRIVILEGED_JWT_TTL_SECONDS=28800
# ACCOUNT_JWT_TTL_SECONDS=604800
