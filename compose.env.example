ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-long-password
JWT_SECRET=replace-with-long-random-secret
MODERATION_FINGERPRINT_SECRET=replace-with-long-random-secret
POSTER_PROOF_SECRET=replace-with-long-random-secret
HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET=replace-with-hcaptcha-secret
AI_PROVIDER=
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-1.5-flash
GOOGLE_TTS_MODEL=gemini-3.1-flash-tts-preview
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=gpt-4-turbo
AI_MODERATION_QUEUE_CONFIDENCE_THRESHOLD=0
MAX_IMAGE_BYTES=52428800
RATE_LIMIT_STORE=memory
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_FAILURE_MODE=closed
RATE_LIMIT_REDIS_PREFIX=36chan:rate-limit:
# Required in production when behind a reverse proxy/load balancer so rate
# limits and moderation fingerprints use the real client IP from X-Forwarded-For.
TRUST_PROXY=1
# Prometheus scrape secret for /metrics and /api/metrics (Bearer, X-Metrics-Token, or ?token=).
# In production without this token, only loopback scrapes are allowed.
METRICS_TOKEN=replace-with-long-random-metrics-token
# Optional comma-separated browser origins allowed for SSE CORS (production cross-origin).
# CORS_ORIGINS=https://36chan.example
# Short in-process cache for /api/config, /api/boards, /api/stats (ms). 0 disables.
PUBLIC_READ_CACHE_MS=2000
# JWT lifetime overrides (seconds): privileged roles default 8h, accounts default 7d.
# PRIVILEGED_JWT_TTL_SECONDS=28800
# ACCOUNT_JWT_TTL_SECONDS=604800
